# Server .gitignore for Resolver

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build
dist/
build/

# Environment files & Secrets (NEVER push to GitHub)
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.crt
*.p12

# Accidental local docs/results output inside server/
docs/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temp & Cache
.cache/
*.tmp
*.temp
*.bak
*.tsbuildinfo
