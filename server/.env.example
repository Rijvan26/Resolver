# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Database (MongoDB Atlas URI required in production)
MONGODB_URI=mongodb://localhost:27017/resolver
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=8000

# Redis (Local Docker: redis://localhost:6379 | Upstash TLS: rediss://default:<password>@<endpoint>.upstash.io:6379)
REDIS_URL=redis://localhost:6379

# JWT Secrets (replace with strong random strings in production, min 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_security
JWT_REFRESH_EXPIRES_IN=7d

# Cookies, Reverse Proxy & CORS Security
COOKIE_SECRET=your_cookie_signing_secret_min_32_characters_long
# Set to "none" for cross-origin HTTPS deployments (e.g. Vercel/Render frontend + Render backend), or "lax" for same-origin/dev
COOKIE_SAME_SITE=lax
# Number of reverse proxy hops in front of Express (Render = 1)
TRUST_PROXY=1
# Comma-separated allowed frontend origins in production
CORS_ORIGIN=http://localhost:5173

# Invitation Link Base URL (must match production frontend URL in prod)
INVITATION_BASE_URL=http://localhost:5173/accept-invitation

# Email Delivery Configuration (Brevo SMTP - optional, skips gracefully if unset)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# BREVO_SMTP_USER=your_brevo_smtp_login
# BREVO_SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="Resolver Notifications <notifications@resolver.internal>"

# ==============================================================================
# AI Phase 1 Configuration (SRS-AI-001)
# ==============================================================================
# AI_ENABLED: Set to true to enable AI background triage, summary, and postmortem drafting
AI_ENABLED=false

# AI_PROVIDER: Select provider adapter (fake | groq | gemini | ollama)
AI_PROVIDER=fake

# AI_MODEL: Model identifier (never hardcoded in code)
# Examples:
#   Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b
#   Gemini: gemini-3.5-flash-lite, gemini-3.8-flash
#   Ollama: llama3:8b, mistral:7b
AI_MODEL=qwen/qwen3.8-27b

# External API Keys (backend .env / Render env vars only; NEVER commit real keys)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama endpoint (used only if AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Safety, timeouts, and throttling
AI_TIMEOUT_MS=30000
AI_DAILY_CAP=50
AI_REDACT_IPS=true

# ==============================================================================
# AI Phase 2 & 3 Embeddings, Alert Grouping, Runbooks & Assistant (SRS-AI-001)
# ==============================================================================
# EMBEDDING_PROVIDER: fake | gemini | ollama
EMBEDDING_PROVIDER=fake
# EMBEDDING_MODEL: gemini-embedding-001 | nomic-embed-text
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=10

# Similar Incidents (FR-07)
AI_SIMILAR_THRESHOLD=0.60
AI_SIMILAR_SERVICE_BOOST=0.05

# Duplicate Detection (FR-06)
AI_DUPLICATE_THRESHOLD=0.70
AI_DUPLICATE_WINDOW_HOURS=24

# Alert Grouping (FR-08)
AI_ALERT_GROUPING_ENABLED=true
AI_ALERT_GROUPING_WINDOW_MINUTES=30
AI_ALERT_GROUPING_SIMILARITY_THRESHOLD=0.82

# Runbooks & Assistant (FR-10 / FR-11)
AI_RUNBOOK_ENABLED=true
AI_RUNBOOK_EXPLANATION_ENABLED=false
AI_ASSISTANT_ENABLED=true

# Alert Ingestion Webhook Authentication & Rate Limiting (MANDATORY to change in production!)
ALERT_INGEST_SECRET=your_alert_ingest_shared_secret_min_32_chars
ALERT_FLOOD_INCIDENT_CAP=10
ALERT_FLOOD_WINDOW_MINUTES=10
ALERT_RATE_LIMIT_MAX=120
