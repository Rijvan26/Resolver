# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/resolver
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=8000

# Redis (Docker: docker run -d --name resolver-redis -p 6379:6379 redis:7-alpine)
REDIS_URL=redis://localhost:6379

# JWT Secrets (replace with strong random strings in production, min 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_security
JWT_REFRESH_EXPIRES_IN=7d

# Cookies & Security
COOKIE_SECRET=your_cookie_signing_secret_min_32_characters_long
CORS_ORIGIN=http://localhost:5173

# Invitation Link Base URL (for email or dev output)
INVITATION_BASE_URL=http://localhost:5173/accept-invitation

# Email Delivery Configuration (Optional - required when production SMTP provider is connected)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="Resolver Notifications <notifications@resolver.internal>"

# ==============================================================================
# AI Phase 1 Configuration (SRS-AI-001)
# ==============================================================================
# AI_ENABLED: Set to true to enable AI background triage, summary, and postmortem drafting
AI_ENABLED=false

# AI_PROVIDER: Select provider adapter (fake | groq | gemini | ollama)
# fake: deterministic offline mock (zero API keys, default for dev/test)
# groq: fast cloud inference via Groq OpenAI-compatible API
# gemini: Google Generative AI API
# ollama: local self-hosted LLM via Ollama HTTP API
AI_PROVIDER=fake

# AI_MODEL: Model identifier (never hardcoded in code)
# Examples:
#   Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b
#   Gemini: gemini-3.5-flash-lite, gemini-3.8-flash
#   Ollama: llama3:8b, mistral:7b
AI_MODEL=qwen/qwen3.8-27b

# External API Keys (backend .env only; NEVER commit real keys)
# WARNING: Dev data must be fake/test incidents only. Free-tier APIs must not receive real customer data.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama endpoint (used only if AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Safety, timeouts, and throttling
AI_TIMEOUT_MS=30000
AI_DAILY_CAP=50
AI_REDACT_IPS=true
