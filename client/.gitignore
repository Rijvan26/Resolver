# Client .gitignore for Resolver

# Dependencies
node_modules/
.pnp
.pnp.js

# Production output
dist/
dist-ssr/
build/
.vite/
*.local

# Environment files & Secrets (NEVER push to GitHub)
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.crt
*.p12

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Temporary / cache files
.cache/
.eslintcache
.stylelintcache
*.tmp
*.temp
*.bak
*.tsbuildinfo
